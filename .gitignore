# ---------- 1. Secrets / 本地配置（最关键） ----------
# 以下文件含明文密钥：DeepSeek / DashScope Key、ES 密码、JWT secret、MinIO、MySQL 密码
src/main/resources/application.yml
src/main/resources/application-dev.yml
src/main/resources/application-docker.yml
src/main/resources/application-local.yml
src/main/resources/application-prod.yml
src/main/resources/application-secret.yml
*.pem
*.key
*.p12
*.jks
*.keystore
*.local
.env.local
.env.*.local

# ---------- 2. Java / Maven ----------
/target/
/out/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
*.ctxt
.mtj.tmp/
hs_err_pid*
replay_pid*
*.hprof

# ---------- 3. Frontend / Node ----------
node_modules/
dist
dist-ssr
.vite-ssg-dist
.vite-ssg-temp
coverage
.pnpm-store/
.turbo/
